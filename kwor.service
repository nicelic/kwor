# kwor-owner:v1 resource=panel-systemd
[Unit]
Description=kwor Service
After=network.target nss-lookup.target

[Service]
Type=simple
Environment=KWOR_INTERNAL_SYSTEMD=1
ExecCondition=/usr/local/kwor/kwor lifecycle-guard
WorkingDirectory=/usr/local/kwor/
ExecStart=/usr/local/kwor/kwor
Restart=on-failure
RestartSec=5s
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
